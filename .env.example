# -------------------------------------------------------------
# LoveMatch — Environment Variables Configuration Template
# Copy this file to `.env` and configure your local/production values.
# -------------------------------------------------------------

# Application Security
DEBUG=True
SECRET_KEY=django-insecure-prod-lovematch-enterprise-key-replace-in-production-998877
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# Database Connection (Default: SQLite for local dev, PostgreSQL for production)
# Example PostgreSQL: postgres://loveuser:lovepass@localhost:5432/lovematch_db
DATABASE_URL=sqlite:///db.sqlite3

# Redis / Channel Layer (for real-time WebSockets and Celery)
# Example: redis://localhost:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# AI Icebreaker & Smart Assistant (Google Gemini API Key)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# Static & Media Storage
STATIC_URL=/static/
MEDIA_URL=/media/

# Security Headers (Set to True in production with SSL)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
